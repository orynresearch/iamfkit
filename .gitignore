# =============================================================================
# iamfkit — repo-wide .gitignore
#
# Covers: CMake/C/C++, Python, Flutter/Dart, React Native/Expo, WASM/Node,
# Xcode/iOS/macOS, Android/Gradle, and general OS/editor noise.
#
# !!! DO NOT ADD THE FOLLOWING TO THIS FILE, EVER !!!
#   - code/                (the vendored, patched libiamf + oar source —
#                            this is deliberately committed, not fetched at
#                            build time; see "Vendoring, not submoduling"
#                            in the project brief. Accidentally ignoring
#                            this — or any pattern broad enough to catch
#                            it, like a bare "build" without a trailing
#                            slash matching a real source subfolder — would
#                            silently drop the oar channel-mapping fix from
#                            the repo.)
#   - any *.iamf / *.textproto test fixture paths (regression-test inputs)
#   - iamfkit.h / iamfkit.c or any other c-wrapper source
#
# If you're adding a new pattern and you're not sure whether it could
# accidentally match something above, scope it to a specific known build
# output folder (e.g. "iamfkit_wasm/dist/") rather than a bare generic name.
# =============================================================================


!!! THIS FILE WAS GENERATED WITH THE ASSISTANCE OF CLAUDE. This file has been manually reviewed manually !!!


# ---------------------------------------------------------------------------
# General / OS / editors
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
*.log
*.tmp
*.swp
*.swo
*~
.vscode/
.idea/
*.iml

# ---------------------------------------------------------------------------
# CMake / C / C++ (c-wrapper, native builds under code/, iamfkit_c/)
#
# Scoped to actual build-output directory names, not bare "build" — several
# ecosystems below (Flutter, Android, Python) also produce a "build/"
# directory, all intentionally covered by their own sections further down,
# but nothing here should ever match source directories under code/.
# ---------------------------------------------------------------------------
cmake-build-*/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
install_manifest.txt
compile_commands.json
*.o
*.obj
*.a
*.lib
*.pdb
*.ilk
*.exp

# Compiled shared-library output. These are published as GitHub Release
# artifacts by CI, not committed to the repo — if that ever changes for a
# specific prebuilt binary someone deliberately wants tracked, add a
# targeted !path/to/that/one/file.dylib exception rather than removing
# these lines.
*.dylib
*.so
*.so.*
*.dll
*.exe

# Per-ecosystem native build output directories
/build/
/**/build/
iamfkit_c/build/
code/build/

# ---------------------------------------------------------------------------
# Python (iamfkit_python/)
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.venv/
venv/
env/
dist/
wheelhouse/
*.whl
pip-wheel-metadata/

# ---------------------------------------------------------------------------
# Node / React Native / Expo / WASM TypeScript SDK
# (iamfkit_react_native/, iamfkit_wasm/)
#
# Deliberately NOT ignoring *.js or *.ts anywhere — real source code in
# both of these packages uses those extensions. Only known build/output
# directory names and package-manager caches are ignored here.
# ---------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.turbo/
.expo/
.expo-shared/
web-build/
*.tsbuildinfo

# Build output specifically — scoped to dist/ dirs inside these packages,
# not a bare top-level /dist which could collide with something else later.
iamfkit_react_native/lib/
iamfkit_react_native/dist/
iamfkit_wasm/dist/
iamfkit_wasm/build/

# Emscripten/WASM compiled output — this is generated by the CI build
# pipeline from code/ + c-wrapper source, never hand-written. If a demo
# under iamfkit_wasm/examples/ ever needs a checked-in prebuilt .wasm for
# GitHub Pages hosting or similar, add a targeted exception for that exact
# file rather than removing this line.
*.wasm

# ---------------------------------------------------------------------------
# React Native — iOS side (inside iamfkit_react_native/ and
# local_music_player/ios/)
# ---------------------------------------------------------------------------
ios/Pods/
ios/build/
ios/.symlinks/
ios/Flutter/Flutter.podspec
ios/Flutter/flutter_export_environment.sh

# Podfile.lock is intentionally NOT ignored for app targets
# (local_music_player) — reproducible builds depend on it. Do not add it
# here without checking whether the target is an app vs. a plugin/library.

# ---------------------------------------------------------------------------
# React Native — Android side / Gradle
# (also covers local_music_player/android/ and any Android sample apps)
# ---------------------------------------------------------------------------
.gradle/
android/build/
android/app/build/
android/.gradle/
android/local.properties
android/captures/
android/.externalNativeBuild/
android/.cxx/
*.apk
*.aab
*.jks
*.keystore
# Debug keystores are conventionally committed for reproducible local
# debug builds — do not let the *.keystore rule above catch this one.
!debug.keystore

# ---------------------------------------------------------------------------
# Xcode / iOS / macOS (iamfkit_flutter/, local_music_player/, native
# xcframework build output)
# ---------------------------------------------------------------------------
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/
DerivedData/
*.hmap
*.ipa
*.dSYM
*.dSYM.zip
*.xcframework/**/*.dSYM

# ---------------------------------------------------------------------------
# Flutter / Dart (iamfkit_flutter/, local_music_player/)
# ---------------------------------------------------------------------------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
**/doc/api/
build/

# pubspec.lock is intentionally NOT blanket-ignored here: convention is to
# commit it for apps (local_music_player) but not for packages/plugins
# (iamfkit_flutter). If you want to enforce this per-directory, add
# targeted rules like "iamfkit_flutter/pubspec.lock" individually rather
# than a repo-wide blanket rule that could strip it from the app by
# accident.

# ---------------------------------------------------------------------------
# Regression test output (NOT test fixtures/inputs — see warning at top)
#
# Only ignore .wav files actually produced by running the regression test
# suite into a dedicated output directory. Never add a blanket *.wav rule
# here — committed audio fixtures elsewhere in the repo must never match
# it.
# ---------------------------------------------------------------------------
**/test-output/
**/*.regression-output.wav